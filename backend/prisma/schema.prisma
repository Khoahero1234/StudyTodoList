enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ConversationType {
  DIRECT
  GROUP
}

enum StudyRoomStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TokenTransactionType {
  PURCHASE
  SPEND
  REWARD
  REFUND
  BONUS
  PREMIUM
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  TASK_REMINDER
  CHAT_MESSAGE
  FRIEND_REQUEST
  STUDY_ROOM_INVITE
  REWARD
  SHOP_PROMOTION
  PREMIUM
  SYSTEM
}

enum PetType {
  CAT
  DOG
  RABBIT
  DRAGON
  PENGUIN
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ============================================================
// 1. USERS & ROLES
// ============================================================

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  username    String  @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  password    String
  role        Role    @default(CUSTOMER)
  isActive    Boolean @default(true)
  isVerified  Boolean @default(false)
  verifyToken String?

  // Gamification
  xp    Int @default(0)
  level Int @default(1)

  // References
  tasks               Task[]
  categories          Category[]
  taskReminders       TaskReminder[]
  goals               Goal[]
  projects            Project[]
  sentFriendReqs      FriendRequest[]         @relation("Requester")
  receivedFriendReqs  FriendRequest[]         @relation("Receiver")
  friends             Friend[]                @relation("UserFriends")
  friendOf            Friend[]                @relation("FriendOf")
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  ownedStudyRooms     StudyRoom[]             @relation("RoomOwner")
  studyRoomMembers    StudyRoomMember[]
  wallet              Wallet?
  tokenTransactions   TokenTransaction[]
  orders              Order[]
  inventoryItems      InventoryItem[]
  premiumSub          PremiumSubscription?
  pet                 Pet?
  pomodoroSessions    PomodoroSession[]
  notifications       Notification[]
  aiConversations     AiConversation[]
  productivityStats   ProductivityStatistic[]
  loginStreak         LoginStreak?
  rewards             UserReward[]
  sentNotifications   Notification[]          @relation("NotificationSender")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([username])
}

// ============================================================
// 2. TASKS
// ============================================================

model Category {
  id     String  @id @default(uuid())
  name   String
  color  String  @default("#6C63FF")
  icon   String?
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)

  // Scheduling
  dueDate          DateTime?
  startTime        String?
  endTime          String?
  estimatedMinutes Int       @default(0)
  actualMinutes    Int       @default(0)

  // Recurring
  isRecurring      Boolean @default(false)
  recurringPattern String? // e.g. "DAILY", "WEEKLY:MON,WED"

  // Metadata
  tags        String[]  @default([])
  tokenReward Int       @default(5)
  xpReward    Int       @default(10)
  completedAt DateTime?

  // Relations
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id])
  subTasks         SubTask[]
  reminders        TaskReminder[]
  pomodoroSessions PomodoroSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model SubTask {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  taskId      String
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskReminder {
  id            String  @id @default(uuid())
  minutesBefore Int // 60, 120, 180, 1440
  isSent        Boolean @default(false)
  taskId        String
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, minutesBefore])
  @@index([taskId])
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String  @default("#6C63FF")
  isArchived  Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

// ============================================================
// 3. FRIENDS
// ============================================================

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  requester   User                @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  message     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId])
}

model Friend {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId])
}

// ============================================================
// 4. CHAT
// ============================================================

model Conversation {
  id            String               @id @default(uuid())
  name          String?
  type          ConversationType     @default(DIRECT)
  avatarUrl     String?
  members       ConversationMember[]
  messages      Message[]
  lastMessage   String?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean      @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           MessageType  @default(TEXT)
  fileUrl        String?
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
}

// ============================================================
// 5. STUDY ROOMS
// ============================================================

model StudyRoom {
  id              String            @id @default(uuid())
  name            String
  description     String?
  avatarUrl       String?
  ownerId         String
  owner           User              @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         StudyRoomMember[]
  maxParticipants Int               @default(10)
  isPrivate       Boolean           @default(false)
  inviteCode      String?           @unique
  status          StudyRoomStatus   @default(ACTIVE)
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([inviteCode])
}

model StudyRoomMember {
  id       String    @id @default(uuid())
  roomId   String
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin  Boolean   @default(false)
  joinedAt DateTime  @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

// ============================================================
// 6. SHOP
// ============================================================

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  iconUrl     String?
  products    Product[]
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  imageUrl       String?
  price          Int // in TOKENS
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  rarity         Rarity          @default(COMMON)
  stock          Int             @default(-1) // -1 = unlimited
  discountPct    Int             @default(0) // 0-100
  isAvailable    Boolean         @default(true)
  isPremiumOnly  Boolean         @default(false)
  orderItems     OrderItem[]
  inventoryItems InventoryItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([isAvailable])
}

// ============================================================
// 7. WALLET & TOKENS
// ============================================================

model Wallet {
  id           String             @id @default(uuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                @default(0) // authoritative token balance
  transactions TokenTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenTransaction {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId     String
  wallet       Wallet               @relation(fields: [walletId], references: [id])
  type         TokenTransactionType
  amount       Int // positive = credit, negative = debit
  balanceAfter Int
  description  String?
  referenceId  String? // order id, task id, etc.

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
  @@index([type])
}

// ============================================================
// 8. ORDERS
// ============================================================

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTokens Int
  status      OrderStatus @default(PENDING)
  items       OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int     @default(1)
  priceAtSale Int // token price at time of purchase

  @@index([orderId])
}

// ============================================================
// 9. INVENTORY
// ============================================================

model InventoryItem {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int     @default(1)
  isEquipped Boolean @default(false)

  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================
// 10. PREMIUM SUBSCRIPTIONS
// ============================================================

model PremiumSubscription {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String // "MONTHLY" | "YEARLY"
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime
  autoRenew   Boolean            @default(false)
  referenceId String? // payment reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([endDate])
}

// ============================================================
// 11. VIRTUAL PET
// ============================================================

model Pet {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         PetType        @default(CAT)
  level        Int            @default(1)
  xp           Int            @default(0)
  hunger       Int            @default(100) // 0-100
  happiness    Int            @default(100) // 0-100
  energy       Int            @default(100) // 0-100
  avatarUrl    String?
  petInventory PetInventory[]

  lastFedAt    DateTime?
  lastPlayedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PetItem {
  id           String         @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  type         String // "FOOD" | "TOY" | "CLOTHES" | "ACCESSORY"
  effectType   String? // "HUNGER" | "HAPPINESS" | "ENERGY"
  effectValue  Int            @default(0)
  price        Int // in TOKENS
  rarity       Rarity         @default(COMMON)
  petInventory PetInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PetInventory {
  id         String  @id @default(uuid())
  petId      String
  pet        Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  itemId     String
  item       PetItem @relation(fields: [itemId], references: [id])
  quantity   Int     @default(1)
  isEquipped Boolean @default(false)

  acquiredAt DateTime @default(now())

  @@unique([petId, itemId])
  @@index([petId])
}

// ============================================================
// 12. POMODORO SESSIONS
// ============================================================

model PomodoroSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?     @relation(fields: [taskId], references: [id])
  focusMinutes      Int       @default(25)
  breakMinutes      Int       @default(5)
  sessionsPlanned   Int       @default(4)
  sessionsCompleted Int       @default(0)
  isCompleted       Boolean   @default(false)
  xpEarned          Int       @default(0)
  tokenEarned       Int       @default(0)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
}

// ============================================================
// 13. NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id])
  type        NotificationType
  title       String
  body        String
  data        Json? // extra payload (taskId, roomId, etc.)
  isRead      Boolean          @default(false)
  scheduledAt DateTime? // for future scheduled notifications

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// ============================================================
// 14. AI
// ============================================================

model AiConversation {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String?
  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  metadata       Json? // extracted task info, plan, etc.

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// ============================================================
// 15. PRODUCTIVITY STATISTICS
// ============================================================

model ProductivityStatistic {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  tasksCreated     Int      @default(0)
  tasksCompleted   Int      @default(0)
  tasksCancelled   Int      @default(0)
  focusMinutes     Int      @default(0) // total pomodoro focus time
  pomodoroSessions Int      @default(0)
  tokensEarned     Int      @default(0)
  tokensSpent      Int      @default(0)
  xpEarned         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ============================================================
// 16. LOGIN STREAKS & REWARDS
// ============================================================

model LoginStreak {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLoginDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reward {
  id          String       @id @default(uuid())
  name        String
  description String?
  type        String // "TOKEN" | "ITEM" | "PREMIUM" | "BADGE"
  value       Int          @default(0) // token amount or item id
  streakDay   Int? // day 1, 3, 7, 14, 30 — nullable for non-streak rewards
  imageUrl    String?
  isActive    Boolean      @default(true)
  userRewards UserReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  claimedAt DateTime @default(now())

  @@unique([userId, rewardId])
  @@index([userId])
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  imageUrl       String?
  price          Int             @default(0)
  rarity         String          @default("common") // common, rare, epic, legendary
  stock          Int             @default(999)
  discountPct    Int             @default(0)
  isAvailable    Boolean         @default(true)
  premiumOnly    Boolean         @default(false)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount Int
  status      String      @default("completed") // completed, pending, cancelled
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Int
}

model InventoryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model LoginStreak {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastLoginDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Reward {
  id             String        @id @default(uuid())
  title          String
  description    String?
  type           String        // 'token', 'item', 'xp'
  amount         Int           @default(10)
  requiredStreak Int           @default(1)
  isActive       Boolean       @default(true)
  userRewards    UserReward[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  claimedAt DateTime @default(now())

  @@unique([userId, rewardId])
}
